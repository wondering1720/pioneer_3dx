<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pioneer_3dx_camera">

  <!-- Importar el chasis base del Pioneer 3-DX -->
  <xacro:include filename="$(find p2os_urdf)/defs/pioneer3dx.xacro"/>

  <!-- Definir el eslabón físico de la cámara web -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.04 0.08 0.04"/> <!-- Un rectángulo pequeño representando la webcam -->
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>

  <!-- Fijar la cámara a la placa superior del robot -->
  <joint name="camera_joint" type="fixed">
    <parent link="top_plate"/>
    <child link="camera_link"/>
    <origin xyz="0.1 0 0.1" rpy="0 0 0"/> 
  </joint>

  <!-- Plugin de Gazebo para transmitir el video -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="webcam_sensor">
      <update_rate>15.0</update_rate> <!-- 15 FPS igual que tu hardware real -->
      <camera name="head">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>320</width>  <!-- 320x240 igual que en WSL2 -->
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>sim_camera</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>camera_link</frameName>
      </plugin>
    </sensor>
  </gazebo>
</robot>